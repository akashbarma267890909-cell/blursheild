<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.BlurShield" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Text colours -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>

        <!-- Disable the default action bar entirely -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- SeekBar accent colour -->
        <item name="colorAccent">@color/primary_blue</item>
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/background</item>
    </style>
</resources>
